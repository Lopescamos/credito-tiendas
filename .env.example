# ============================================================
# Plantilla de variables de entorno
# ============================================================
# Copia este archivo como .env y llena los valores
# Este archivo SÍ se sube a git (es solo la plantilla)
# ============================================================

APP_PROFILE=dev

# Mínimo 32 caracteres (256 bits). Generar con: openssl rand -base64 32
JWT_SECRET=
# Duración del token en milisegundos (86400000 = 24 h)
JWT_EXPIRATION=86400000

CLOUDINARY_URL=

# Admin Sistema inicial: se crea al arrancar si no existe ninguno (contraseña de 8 a 72 caracteres)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Solo para producción (configurar en Render dashboard) ---
# DATABASE_URL=jdbc:postgresql://db.xxxx.supabase.co:5432/postgres
# DATABASE_USER=postgres
# DATABASE_PASSWORD=
# CORS_ALLOWED_ORIGINS=https://creditotiendas.vercel.app
